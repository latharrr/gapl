{
  "crons": [
    { "path": "/api/cron/daily-alerts", "schedule": "0 6 * * *" },
    { "path": "/api/cron/day1-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/cron/day7-reminder", "schedule": "0 9 * * 1" }
  ],
  "headers": [
    {
      "source": "/living/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
