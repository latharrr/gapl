# Gapl environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local (it is gitignored). Only NEXT_PUBLIC_* vars are
# exposed to the browser; everything else stays server-side.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used in emails, shortlinks, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dedicated tracking subdomain for email shortlinks (e.g. links.gapl.in)
NEXT_PUBLIC_TRACKING_DOMAIN=links.localhost:3000

# ── Firebase (client SDK — NEXT_PUBLIC_* are visible in the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server only) ───────────────────────────────────
# The whole service-account JSON on ONE line, e.g.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── AI providers (server only) ─────────────────────────────────────────
# At least one provider key is required for /api/analyze to work.
# Failover: routed provider (default Groq) -> OpenAI -> Anthropic/Gemini; an attempt with a
# missing provider key runs on FreeModel if FREEMODEL_API_KEY is set, else Groq (src/lib/ai-gateway.ts)
GROQ_API_KEY=
FREEMODEL_API_KEY=
FREEMODEL_API_URL=https://api.freemodel.dev/v1/chat/completions
FREEMODEL_MODEL=
FREEMODEL_TOKEN_PRICE_INPUT=
FREEMODEL_TOKEN_PRICE_OUTPUT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# If set to "true", AI call request/response bodies are logged (dev only)
AI_LOG_CONTENT=false

# ── Resend email (server only) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gapl <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=

# ── Razorpay payments (server only, except key id) ─────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Cron / ops (server only) ───────────────────────────────────────────
# Shared secret for /api/cron/* routes (Vercel Cron sends it as Authorization header)
CRON_SECRET=
# Where founder alert emails go
ADMIN_ALERT_EMAIL=

# Rate used to convert USD AI costs to INR in admin profit figures (default 84)
USD_TO_INR_RATE=84
